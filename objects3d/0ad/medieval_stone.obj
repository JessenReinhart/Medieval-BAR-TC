v -4.0 9.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 0.0 -1.0
vn 1.0 0.0 0.0
vn 0.0 0.0 1.0
vn -1.0 0.0 0.0
usemtl medieval_stone
